# typed: strict
# frozen_string_literal: true

# Formula for the pace network measurement CLI.
class Pace < Formula
  desc "Speed tests for proxies, campus intranets and CERNET"
  homepage "https://github.com/soundadam/pace"
  url "https://github.com/soundadam/pace/releases/download/v@VERSION@/pace-@VERSION@.tar.gz"
  sha256 "@SOURCE_SHA256@"
  license all_of: ["MIT", "LGPL-3.0-only", "Apache-2.0"]
  depends_on "go" => :build

  resource "ndt7-client" do
    url "https://github.com/m-lab/ndt7-client-go/archive/refs/tags/v0.10.1.tar.gz"
    sha256 "31b40268bd7a9d31bdb5507b7ade2fad2efb8abb9e7339d2f59e9cdee5340bef"
  end

  def install
    version_ldflags = %W[
      -s -w
      -X github.com/soundadam/pace/internal/buildinfo.Version=#{version}
      -X github.com/soundadam/pace/internal/buildinfo.Commit=v#{version}
      -X github.com/soundadam/pace/internal/buildinfo.Date=1970-01-01T00:00:00Z
    ].join(" ")
    system "go", "build", *std_go_args(ldflags: version_ldflags), "./cmd/pace"

    helper_dir = libexec/"pace"
    helper_dir.mkpath

    cd "components/librespeed-cli" do
      ldflags = %w[
        -s -w -buildid=
        -X github.com/librespeed/speedtest-cli/defs.ProgName=librespeed-cli
        -X github.com/librespeed/speedtest-cli/defs.ProgVersion=v1.0.13-campus.1
        -X github.com/librespeed/speedtest-cli/defs.BuildDate=1970-01-01T00:00:00Z
      ].join(" ")
      system "go", "build", "-trimpath", "-ldflags", ldflags,
             "-o", helper_dir/"librespeed-cli", "./"
      (pkgshare/"licenses/librespeed-cli").install "LICENSE"
    end

    resource("ndt7-client").stage do
      ldflags = %w[
        -s -w -buildid=
        -X main.ClientName=pace
        -X main.ClientVersion=0.10.1
      ].join(" ")
      system "go", "build", "-trimpath", "-ldflags", ldflags,
             "-o", helper_dir/"ndt7-client", "./cmd/ndt7-client"
      (helper_dir/"ndt7-client.version").write "v0.10.1\n"
      (pkgshare/"licenses/ndt7-client").install "LICENSE"
    end

    pkgshare.install "LICENSE", "THIRD_PARTY_NOTICES.md"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/pace version")

    diagnostics = shell_output("#{bin}/pace doctor --json")
    assert_match '"ready":true', diagnostics
    assert_match '"campus":"ready"', diagnostics
    assert_match '"mlab":"ready"', diagnostics

    assert_equal "[]\n", shell_output("#{bin}/pace history --json")
  end
end
